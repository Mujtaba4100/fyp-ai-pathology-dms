# General Settings
APP_NAME=EMR System
DEBUG=True

# JWT & Authentication
SECRET_KEY=change_this_to_a_secure_random_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys
# Hugging Face Serverless Inference Engine (Llama-3.3-70B)
HF_TOKEN=hf_your_hugging_face_token_here
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# PostgreSQL Settings (Primary Relational, Vector Search & File Vault Database)
# All documents, embeddings, and file bytes are stored in PostgreSQL.
# Use DATABASE_URL if you want to use a single connection string (e.g. Neon Cloud)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emr_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
