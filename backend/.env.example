# General Settings
APP_NAME=EMR System
DEBUG=True

# JWT & Authentication
SECRET_KEY=change_this_to_a_secure_random_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (Provide your own keys to run the LLMs)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Settings (Primary Relational & Vector Search Database)
# Use DATABASE_URL if you want to use a single connection string (e.g. Neon Cloud)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emr_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# MS SQL Server Settings (Simulation of legacy hospital file storage)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=EMRDocuments
MSSQL_USER=sa
MSSQL_PASSWORD=your_mssql_password
